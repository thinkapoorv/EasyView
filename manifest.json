{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "easyview@easyview.in",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "default_locale": "en",
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "1.1.1.6",
  "description": "__MSG_appDesc__",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "js/constants/tier-schema.js",
      "gemini-service.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/constants/tier-schema.js",
        "dom-utils.js",
        "content.js",
        "js/features/selection-tooltip.js",
        "js/features/content-privacy-shield.js",
        "js/features/sticky-notes.js",
        "inject/index.js",
        "inject/payment-bridge.js"
      ],
      "css": [
        "content.css",
        "js/features/sticky-notes.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-sticky": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Command+Shift+S"
      },
      "description": "Pin Sticky Note"
    },
    "toggle-privacy": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle Privacy Shield"
    },
    "toggle-highlighter": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle Highlighter Mode"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "styles.css",
        "inject/sensory.js",
        "inject/network-interceptor.js",
        "sandbox.html",
        "sandbox.js",
        "fonts/kindle/Fast_OpenDyslexic/*.otf",
        "fonts/kindle/Fast_Sans/*.otf",
        "fonts/kindle/Fast_Serif/*.otf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
